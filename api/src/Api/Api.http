@Api_HostAddress = http://localhost:5292

### Store an IFC file
POST {{Api_HostAddress}}/store
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="sample.ifc"
Content-Type: application/octet-stream

ISO-10303-21;
--boundary--

### Fetch all models
GET {{Api_HostAddress}}/models
Accept: application/json

### Fetch one model (replace the id with one from the list)
@ModelId = 00000000-0000-0000-0000-000000000000
GET {{Api_HostAddress}}/models/{{ModelId}}
Accept: application/json

### Download a model's IFC file
GET {{Api_HostAddress}}/models/{{ModelId}}/file

###
